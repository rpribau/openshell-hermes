+    python3 -I -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' \
+        "https://nodejs.org/dist/v26.12.1/node-v26.12.1-${node_arch}.tar.xz" /tmp/node26.tar.xz; \
